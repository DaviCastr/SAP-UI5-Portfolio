<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <!--
        Card de repositorio do GitHub.

        O card inteiro e clicavel (delegado no BaseController via .pf-repo) e nao
        tem botao interno: a URL vem do campo "url" do proprio objeto, e um
        botao "Repositorio" repetiria a acao sem acrescentar informacao.
    -->
    <VBox class="pf-repo">
        <HBox alignItems="Center" class="pf-repo__head">
            <HBox class="pf-repo__icon" alignItems="Center">
                <core:Icon src="sap-icon://folder" class="pf-text-lg"/>
            </HBox>
            <VBox class="pf-gap-0">
                <Text class="pf-repo__name" text="{name}"/>
                <HBox alignItems="Center" class="pf-gap-1 pf-muted pf-small" visible="{= !!${pushedAt}}">
                    <core:Icon src="sap-icon://history" class="pf-text-xs"/>
                    <Text text="{path: 'pushedAt', formatter: '.fMonthYear'}"/>
                </HBox>
            </VBox>
        </HBox>

        <Text class="pf-repo__desc" text="{description}" visible="{= !!${description}}"/>

        <HBox class="pf-chips" items="{path: 'topicItems', templateShareable: true}">
            <core:Fragment fragmentName="davi.portfolio.fragment.Chip" type="XML"/>
        </HBox>

        <HBox class="pf-project__foot">
            <HBox alignItems="Center" class="pf-gap-1 pf-muted pf-small" visible="{= !!${language}}">
                <core:Icon src="sap-icon://source-code" class="pf-text-xs"/>
                <Text text="{language}"/>
            </HBox>
            <HBox alignItems="Center" class="pf-project__stat" visible="{= !!${stars}}">
                <core:Icon src="sap-icon://favorite" class="pf-text-xs"/>
                <Text text="{stars}"/>
            </HBox>
            <HBox alignItems="Center" class="pf-project__stat" visible="{= !!${forks}}">
                <core:Icon src="sap-icon://share" class="pf-text-xs"/>
                <Text text="{forks}"/>
            </HBox>
        </HBox>
    </VBox>
</core:FragmentDefinition>