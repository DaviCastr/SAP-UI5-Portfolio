<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <VBox class="pf-project">
        <HBox alignItems="Center" class="pf-project__head">
            <HBox class="pf-project__icon" alignItems="Center">
                <core:Icon src="{path: 'icon', formatter: '.fIcon'}" class="pf-text-lg"/>
            </HBox>
            <Text class="pf-project__name" text="{name}"/>
        </HBox>

        <Text class="pf-project__desc" text="{description}"/>

        <HBox class="pf-chips" items="{path: 'stackItems', templateShareable: true}">
            <core:Fragment fragmentName="davi.portfolio.fragment.Chip" type="XML"/>
        </HBox>

        <VBox class="pf-gap-1" visible="{= !!${highlightsItems} &amp;&amp; ${highlightsItems}.length > 0}">
            <HBox items="{path: 'highlightsItems', templateShareable: true}">
                <Text class="pf-bullet pf-small pf-muted" text="{label}"/>
            </HBox>
        </VBox>

        <HBox class="pf-project__foot">
            <HBox alignItems="Center" class="pf-gap-1 pf-muted pf-small" visible="{= !!${language}}">
                <core:Icon src="sap-icon://source-code" class="pf-text-xs"/>
                <Text text="{language}"/>
            </HBox>
            <HBox alignItems="Center" class="pf-project__stat" visible="{= !!${stars}}">
                <core:Icon src="sap-icon://favorite" class="pf-text-xs"/>
                <Text text="{stars}"/>
            </HBox>
            <HBox alignItems="Center" class="pf-project__stat" visible="{= !!${forks}}">
                <core:Icon src="sap-icon://share" class="pf-text-xs"/>
                <Text text="{forks}"/>
            </HBox>
            <HBox alignItems="Center" class="pf-gap-1 pf-muted pf-small" visible="{= !!${updatedAt}}">
                <core:Icon src="sap-icon://history" class="pf-text-xs"/>
                <Text text="{updatedAt}"/>
            </HBox>
        </HBox>

        <HBox class="pf-gap-2">
            <Button
                type="Transparent"
                icon="sap-icon://folder"
                text="{i18n>project.repository}"
                press="onRepoPress"
                visible="{= !!${repo}}"/>
            <Button
                type="Transparent"
                icon="sap-icon://world"
                text="{i18n>project.website}"
                press="onUrlPress"
                visible="{= !!${url}}"/>
        </HBox>
    </VBox>
</core:FragmentDefinition>