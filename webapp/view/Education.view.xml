<mvc:View
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    controllerName="davi.portfolio.controller.Education"
    class="pf-view">
    <Page id="page" class="pf-page-scroll" enableScrolling="true" title="{i18n>nav.education}">
        <content>
            <VBox class="pf-container pf-page">

                <!-- Cabecalho -->
                <VBox class="pf-page__head">
                    <Text class="pf-eyebrow" text="{i18n>education.eyebrow}"/>
                    <Title level="H1" class="pf-page__title" text="{i18n>education.title}"/>
                    <Text class="pf-lead" text="{i18n>education.subtitle}"/>
                </VBox>

                <!-- Formacao academica -->
                <VBox class="pf-stack pf-gap-4" items="{path: '/education', templateShareable: true}">
                    <HBox class="pf-tl-item" alignItems="Stretch">
                        <VBox class="pf-tl-item__marker">
                            <core:Icon src="sap-icon://education" class="pf-text-s"/>
                        </VBox>

                        <VBox class="pf-card pf-stack pf-gap-2 pf-grow-1">
                            <HBox alignItems="Center" class="pf-row--between pf-row--wrap pf-gap-3">
                                <VBox>
                                    <Text class="pf-tl-item__role" text="{degree}"/>
                                    <Text class="pf-tl-item__company" text="{institution}"/>
                                </VBox>
                                <HBox alignItems="Center" class="pf-gap-2 pf-small pf-strong pf-chip pf-chip--primary">
                                    <Text text="{path: 'period/from', formatter: '.fMonthYear'}"/>
                                    <Text text="-"/>
                                    <Text text="{path: 'period/to', formatter: '.fMonthYear'}"/>
                                </HBox>
                            </HBox>

                            <Text class="pf-card__body" text="{description}"/>

                            <HBox class="pf-chips" items="{path: 'tagItems', templateShareable: true}">
                                <core:Fragment fragmentName="davi.portfolio.fragment.Chip" type="XML"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Cursos livres -->
                <VBox class="pf-stack pf-gap-3" visible="{= !!${content>/courses} &amp;&amp; ${content>/courses}.length > 0}">
                    <Text class="pf-eyebrow" text="{i18n>education.coursesEyebrow}"/>
                    <HBox class="pf-grid pf-grid--skills" items="{path: '/courses', templateShareable: true}">
                        <VBox class="pf-skill">
                            <HBox alignItems="Center" class="pf-gap-3">
                                <HBox class="pf-skill__icon" alignItems="Center">
                                    <core:Icon src="sap-icon://notes" class="pf-text-lg"/>
                                </HBox>
                                <Text class="pf-skill__name" text="{name}"/>
                            </HBox>
                            <Text class="pf-skill__desc" text="{issuer}" visible="{= !!${issuer}}"/>
                            <Text class="pf-small pf-muted" text="{path: 'issuedAt', formatter: '.fDate'}" visible="{= !!${issuedAt}}"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Estado vazio -->
                <VBox
                    class="pf-empty"
                    visible="{= ${content>/education} ? ${content>/education}.length === 0 : false }">
                    <core:Icon src="sap-icon://education" class="pf-text-xl pf-muted"/>
                    <Text text="{i18n>education.empty}"/>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>