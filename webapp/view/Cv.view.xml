<mvc:View
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    controllerName="davi.portfolio.controller.Cv"
    class="pf-view pf-view--cv">
    <Page id="page" class="pf-page-scroll" enableScrolling="true" showHeader="false">
        <content>
            <VBox class="pf-container pf-page">

                <!-- Cabecalho. Download e impressao ficam na barra de secao (App.view.xml). -->
                <VBox>
                    <Text class="pf-eyebrow" text="{i18n>cv.eyebrow}"/>
                    <Title level="H1" class="pf-page__title" text="{i18n>cv.title}"/>
                    <Text class="pf-lead" text="{i18n>cv.subtitle}"/>
                </VBox>

                <!-- Curriculo em A4 -->
                <VBox class="pf-sheet">
                    <!-- Cabecalho do curriculum -->
                    <HBox class="pf-sheet__head" alignItems="Center">
                        <Image
                            class="pf-sheet__avatar"
                            src="{content>/profile/avatar}"
                            densityAware="false"
                            alt="{content>/profile/name}"/>
                        <VBox class="pf-grow-1 pf-gap-1">
                            <Title level="H2" class="pf-sheet__name" text="{content>/profile/name}"/>
                            <Text class="pf-sheet__role" text="{content>/profile/role}"/>
                            <HBox class="pf-sheet__contacts">
                                <Text text="{content>/profile/email}"/>
                                <Text text="{path: 'content>/profile/phone', formatter: '.fPhone'}"/>
                                <Text text="{content>/profile/location}"/>
                            </HBox>
                            <HBox class="pf-chips" items="{path: '/navLinks', templateShareable: true}">
                                <!-- <Button class="pf-chip" text="{text}"/> -->
                                <Button
                                    type="Transparent"
                                    icon="{path: 'icon', formatter: '.fIcon'}"
                                    text="{text}"
                                    tooltip="{text}"
                                    iconDensityAware="false"
                                    press="onLinkPress"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- Resumo -->
                    <VBox class="pf-sheet__section">
                        <Text class="pf-sheet__section-title" text="{i18n>cv.summary}"/>
                        <Text class="pf-sheet__text" text="{content>/profile/summary}"/>
                    </VBox>

                    <!-- Indicadores -->
                    <HBox class="pf-sheet__metrics">
                        <VBox class="pf-sheet__metric">
                            <Text class="pf-sheet__metric-value" text="{content>/metrics/yearsOfExperience}"/>
                            <Text class="pf-small pf-muted" text="{i18n>metric.years}"/>
                        </VBox>
                        <VBox class="pf-sheet__metric">
                            <Text class="pf-sheet__metric-value" text="{content>/metrics/projectCount}"/>
                            <Text class="pf-small pf-muted" text="{i18n>metric.projects}"/>
                        </VBox>
                        <VBox class="pf-sheet__metric">
                            <Text class="pf-sheet__metric-value" text="{content>/metrics/certificateCount}"/>
                            <Text class="pf-small pf-muted" text="{i18n>metric.certificates}"/>
                        </VBox>
                        <VBox class="pf-sheet__metric">
                            <Text class="pf-sheet__metric-value" text="{content>/metrics/skillCount}"/>
                            <Text class="pf-small pf-muted" text="{i18n>metric.skills}"/>
                        </VBox>
                    </HBox>

                    <!-- Experiencia -->
                    <VBox class="pf-sheet__section">
                        <Text class="pf-sheet__section-title" text="{i18n>nav.experience}"/>
                        <VBox class="pf-stack pf-gap-3" items="{path: '/experiences', length: 20, templateShareable: true}">
                            <VBox>
                                <HBox alignItems="Center" class="pf-row--between pf-gap-3">
                                    <Text class="pf-sheet__item-title" text="{role}"/>
                                    <Text class="pf-small pf-muted" text="{path: 'period', formatter: '.fPeriod'}"/>
                                </HBox>
                                <Text class="pf-small pf-muted" text="{company}"/>
                                <Text class="pf-sheet__text" text="{summary}"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!--
                        Competencias: ferramentas e comportamento em blocos
                        separados. `metrics/stacksItems` sao as stacks de todos os
                        projetos; `/softSkills` vem da categoria "Soft Skills" de
                        skills.json (ver isSoftSkill em viewData.ts).
                    -->
                    <VBox class="pf-sheet__section">
                        <Text class="pf-sheet__section-title" text="{i18n>nav.skills}"/>
                        <HBox class="pf-chips" items="{path: '/metrics/stacksItems', templateShareable: true}">
                            <core:Fragment fragmentName="davi.portfolio.fragment.Chip" type="XML"/>
                        </HBox>
                    </VBox>

                    <VBox class="pf-sheet__section" visible="{= !!${/softSkills} &amp;&amp; ${/softSkills}.length > 0}">
                        <Text class="pf-sheet__section-title" text="{i18n>cv.softSkills}"/>
                        <HBox class="pf-chips" items="{path: '/softSkills', templateShareable: true}">
                            <Text class="pf-chip" text="{name}"/>
                        </HBox>
                    </VBox>

                    <!-- Projetos -->
                    <VBox class="pf-sheet__section">
                        <Text class="pf-sheet__section-title" text="{i18n>nav.projects}"/>
                        <VBox class="pf-stack pf-gap-3" items="{path: '/featuredProjects', length: 8, templateShareable: true}">
                            <VBox>
                                <HBox alignItems="Center" class="pf-gap-2">
                                    <Text class="pf-sheet__item-title" text="{name}"/>
                                    <Text class="pf-small pf-muted" text="{description}"/>
                                </HBox>
                                <HBox class="pf-chips" items="{path: 'stackItems', templateShareable: true}">
                                    <core:Fragment fragmentName="davi.portfolio.fragment.Chip" type="XML"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- Formacao -->
                    <VBox class="pf-sheet__section">
                        <Text class="pf-sheet__section-title" text="{i18n>nav.education}"/>
                        <VBox class="pf-stack pf-gap-2" items="{path: '/education', templateShareable: true}">
                            <HBox alignItems="Center" class="pf-row--between pf-gap-3">
                                <Text class="pf-sheet__item-title" text="{degree}"/>
                                <Text class="pf-small pf-muted" text="{institution}"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!--
                        Certificacoes: apenas as "SAP Certified".

                        `/cvCertificates` ja vem filtrado por `isSapCertified` em
                        `viewData.buildViewData` e ordenado por
                        `orderCertificates`, entao a aba nao repete o filtro.
                        Todas as 18 continuam na aba "Certificacoes" do portfolio
                        (`/filteredCertificates`).

                        O icone, o emissor e o destaque vem de `featured`, que
                        agora vale para todas as itens desta lista.
                    -->
                    <VBox class="pf-sheet__section" visible="{= !!${/cvCertificates} &amp;&amp; ${/cvCertificates}.length > 0 }">
                        <Text class="pf-sheet__section-title" text="{i18n>cv.sapCertifications}"/>
                        <VBox class="pf-stack pf-gap-2" items="{path: '/cvCertificates', templateShareable: true}">
                            <HBox alignItems="Center" class="pf-row--between pf-gap-3">
                                <HBox alignItems="Center" class="pf-gap-2 pf-grow-1">
                                    <core:Icon src="sap-icon://verified" visible="{= !!${featured}}" class="pf-text-s"/>
                                    <Text class="{path: 'featured', formatter: '.fCertTitleClass'}" text="{title}"/>
                                    <Text class="pf-small pf-muted" text="{issuer}" visible="{= !!${featured} &amp;&amp; !!${issuer}}"/>
                                </HBox>
                                <Text class="pf-small pf-muted" text="{path: 'issuedAt', formatter: '.fDate'}"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Rodape -->
                    <HBox class="pf-sheet__foot">
                        <Text class="pf-small pf-muted" text="{i18n>cv.generated}"/>
                        <Text class="pf-small pf-muted" text="{path: 'content>/meta/updatedAt', formatter: '.fDateTime'}"/>
                    </HBox>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>