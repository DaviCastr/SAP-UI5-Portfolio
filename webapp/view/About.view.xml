<mvc:View
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:html="http://www.w3.org/1999/xhtml"
    controllerName="sap-ui5-portfolio.controller.About"
    class="pf-view">
    <Page id="page" class="pf-page-scroll" enableScrolling="true" title="{i18n>nav.about}">
        <content>
            <VBox class="pf-container pf-page">

                <!-- Cabecalho -->
                <VBox class="pf-page__head">
                    <Text class="pf-eyebrow" text="{i18n>about.eyebrow}"/>
                    <Title level="H1" class="pf-page__title" text="{i18n>about.title}"/>
                    <Text class="pf-lead" text="{i18n>about.subtitle}"/>
                </VBox>

                <!-- Perfil + texto -->
                <HBox class="pf-two-col" alignItems="Begin">
                    <VBox class="pf-stack pf-gap-4">
                        <HBox class="pf-stack pf-gap-3" items="{content>/profile/about}">
                            <Text class="pf-prose" text="{this>}"/>
                        </HBox>

                        <VBox class="pf-card pf-stack pf-gap-3">
                            <Text class="pf-card__title" text="{i18n>about.focusTitle}"/>
                            <HBox class="pf-chips" items="{content>/focusSkills}">
                                <Text class="pf-chip pf-chip--primary" text="{name}"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Cartao de contato -->
                    <VBox class="pf-card pf-stack pf-gap-3">
                        <Image
                            class="pf-about__avatar"
                            src="{content>/profile/avatar}"
                            densityAware="false"
                            alt="{content>/profile/name}"/>
                        <VBox class="pf-stack--tight">
                            <Text class="pf-about__name" text="{content>/profile/name}"/>
                            <Text class="pf-muted pf-small" text="{content>/profile/role}"/>
                        </VBox>

                        <html:hr class="pf-separator"/>

                        <VBox class="pf-stack--tight">
                            <HBox alignItems="Center" class="pf-contact-row">
                                <Icon src="sap-icon://email" class="pf-text-s"/>
                                <Text text="{content>/profile/email}"/>
                            </HBox>
                            <HBox alignItems="Center" class="pf-contact-row">
                                <Icon src="sap-icon://phone" class="pf-text-s"/>
                                <Text text="{path: 'content>/profile/phone', formatter: '.fPhone'}"/>
                            </HBox>
                            <HBox alignItems="Center" class="pf-contact-row">
                                <Icon src="sap-icon://map" class="pf-text-s"/>
                                <Text text="{content>/profile/location}"/>
                            </HBox>
                            <HBox alignItems="Center" class="pf-contact-row" visible="{= !!${content>/profile/birthday}}">
                                <Icon src="sap-icon://birthday-cake" class="pf-text-s"/>
                                <Text text="{path: 'content>/profile/birthday', formatter: '.fDate'}"/>
                            </HBox>
                        </VBox>

                        <HBox class="pf-chips" items="{content>/footerLinks}" visible="{= !!${content>/footerLinks} &amp;&amp; ${content>/footerLinks}.length > 0}">
                            <Button
                                type="Transparent"
                                icon="{path: 'icon', formatter: '.fIcon'}"
                                text="{text}"
                                press="onLinkPress"
                                visible="{= !!${url}}"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Idiomas -->
                <VBox class="pf-stack pf-gap-3" visible="{= !!${content>/profile/languages} &amp;&amp; ${content>/profile/languages}.length > 0}">
                    <Text class="pf-eyebrow" text="{i18n>about.languagesEyebrow}"/>
                    <HBox class="pf-grid pf-grid--languages" items="{content>/profile/languages}">
                        <HBox alignItems="Center" class="pf-pill">
                            <Icon src="sap-icon://globe" class="pf-text-s pf-muted"/>
                            <Text class="pf-small" text="{name}"/>
                            <Text class="pf-small pf-muted" text="{level}"/>
                        </HBox>
                    </HBox>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>