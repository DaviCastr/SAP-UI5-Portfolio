<mvc:View
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    controllerName="davi.portfolio.controller.Experience"
    class="pf-view">
    <Page id="page" class="pf-page-scroll" enableScrolling="true" title="{i18n>nav.experience}">
        <content>
            <VBox class="pf-container pf-page">

                <!-- Cabecalho -->
                <VBox class="pf-page__head">
                    <Text class="pf-eyebrow" text="{i18n>experience.eyebrow}"/>
                    <Title level="H1" class="pf-page__title" text="{i18n>experience.title}"/>
                    <Text class="pf-lead" text="{i18n>experience.subtitle}"/>
                </VBox>

                <!-- Indicadores -->
                <HBox class="pf-grid pf-grid--metrics">
                    <VBox class="pf-metric">
                        <Text class="pf-metric__value" text="{content>/metrics/yearsOfExperience}"/>
                        <Text class="pf-metric__label" text="{i18n>metric.years}"/>
                    </VBox>
                    <VBox class="pf-metric">
                        <Text class="pf-metric__value" text="{content>/metrics/companies}"/>
                        <Text class="pf-metric__label" text="{i18n>metric.companies}"/>
                    </VBox>
                    <VBox class="pf-metric">
                        <Text class="pf-metric__value" text="{content>/metrics/moduleCount}"/>
                        <Text class="pf-metric__label" text="{i18n>metric.modules}"/>
                    </VBox>
                    <VBox class="pf-metric">
                        <Text class="pf-metric__value" text="{content>/metrics/sapProjects}"/>
                        <Text class="pf-metric__label" text="{i18n>metric.sapProjects}"/>
                    </VBox>
                </HBox>

                <!-- Filtro por natureza do trabalho -->
                <HBox class="pf-filterbar">
                    <Button
                        class="pf-filter"
                        text="{i18n>experience.filter.all}"
                        type="{= ${ui>/experienceKind} === 'all' ? 'Emphasized' : 'Transparent' }"
                        press="onAllPress"/>
                    <Button
                        class="pf-filter"
                        text="{i18n>experience.filter.job}"
                        type="{= ${ui>/experienceKind} === 'job' ? 'Emphasized' : 'Transparent' }"
                        press="onJobPress"/>
                    <Button
                        class="pf-filter"
                        text="{i18n>experience.filter.project}"
                        type="{= ${ui>/experienceKind} === 'project' ? 'Emphasized' : 'Transparent' }"
                        press="onProjectPress"/>
                </HBox>

                <!-- Linha do tempo -->
                <VBox class="pf-timeline" items="{path: 'content>/filteredExperiences', length: 100}">
                    <core:Fragment fragmentName="davi.portfolio.fragment.ExperienceItem" type="XML"/>
                </VBox>

                <!-- Estado vazio -->
                <VBox
                    class="pf-empty"
                    visible="{= ${content>/filteredExperiences} ? ${content>/filteredExperiences}.length === 0 : false }">
                    <core:Icon src="sap-icon://briefcase" class="pf-text-xl pf-muted"/>
                    <Text text="{i18n>experience.empty}"/>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>