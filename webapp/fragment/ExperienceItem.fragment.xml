<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <VBox class="pf-card">
        <!-- Empresa + periodo -->
        <HBox alignItems="Center" class="pf-row--between pf-row--wrap pf-gap-3">
            <HBox alignItems="Center" class="pf-gap-3">
                <Image
                    class="pf-logo"
                    src="{logo}"
                    densityAware="false"
                    visible="{= !!${logo}}"
                    alt="{company}"/>
                <VBox class="sapUiVBoxTiny">
                    <Text class="pf-tl-item__role" text="{role}"/>
                    <HBox alignItems="Center" class="pf-gap-2">
                        <Text class="pf-tl-item__company" text="{company}"/>
                        <Text
                            class="pf-tl-item__company"
                            text="{workplace}"
                            visible="{= !!${workplace}}"/>
                    </HBox>
                </VBox>
            </HBox>

            <HBox alignItems="Center" class="pf-gap-2 pf-small pf-strong pf-chip pf-chip--primary">
                <Icon src="sap-icon://calendar" class="pf-text-xs"/>
                <Text text="{path: 'period/from', formatter: '.fMonthYear'}"/>
                <Text text="-"/>
                <Text
                    text="{path: 'period/to', formatter: '.fMonthYear'}"
                    visible="{= !!${period/to}}"/>
                <Text text="{i18n>period.current}" visible="{= !${period/to}}"/>
            </HBox>
        </HBox>

        <!-- Descricao -->
        <Text class="pf-card__body" text="{summary}"/>

        <!-- Principais atuacoes -->
        <VBox class="pf-stack pf-gap-2" visible="{= !!${highlights} &amp;&amp; ${highlights}.length > 0}">
            <HBox items="{highlights}">
                <Text class="pf-bullet pf-small pf-muted" text="{this>}"/>
            </HBox>
        </VBox>

        <!-- Modulos SAP -->
        <HBox class="pf-chips" items="{modules}" visible="{= !!${modules} &amp;&amp; ${modules}.length > 0}">
            <Text class="pf-chip" text="{this>}"/>
        </HBox>

        <!-- Stack tecnica -->
        <HBox class="pf-chips" items="{stack}" visible="{= !!${stack} &amp;&amp; ${stack}.length > 0}">
            <Text class="pf-chip" text="{this>}"/>
        </HBox>
    </VBox>
</core:FragmentDefinition>