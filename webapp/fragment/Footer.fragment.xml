<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <VBox class="pf-footer">
        <VBox class="pf-container pf-footer__inner">
            <HBox alignItems="Center" class="pf-row--between pf-row--wrap" width="100%">

                <!--
                    O rodape nao repete nome, cargo nem foto: no topo e no hero
                    ja aparecem, e tres copias do mesmo bloco só competem entre
                    si. Aqui vai o convite de contato, que e o que o leitor
                    procura no fim da pagina.
                -->
                <VBox class="pf-footer__cta">
                    <Text class="pf-strong" text="{i18n>cta.title}"/>
                    <Text class="pf-footer__contact" text="{content>/profile/email}"/>
                </VBox>

                <HBox alignItems="Center" class="pf-gap-4 pf-row--wrap">
                    <!--
                        Os itens e o selectedKey sao definidos em App.controller
                        (publishUiOptions): o sap.m.SegmentedButton declara "buttons"
                        como defaultAggregation (ignora template XML em "items") e
                        o binding de selectedKey em two-way sobrescrevia o model
                        "ui" com string vazia no boot. One-way (:=) nao serve aqui:
                        quebra o boot de fragment no UI5 1.153.

                        So o tema tem toggle: o idioma segue o do navegador (i18n do
                        UI5) e pode ser fixado por ?lang= na URL.
                    -->
                    <SegmentedButton
                        id="themeToggle"
                        selectionChange="onThemeChange"
                        class="pf-footer__toggle"/>
                </HBox>

            </HBox>

            <VBox class="pf-separator pf-mt-4 pf-mb-0"/>

            <HBox alignItems="Center" class="pf-row--between pf-row--wrap" width="100%">
                <HBox class="pf-row--wrap" items="{path: '/footerLinks', templateShareable: true}">
                    <Button
                        type="Transparent"
                        icon="{path: 'icon', formatter: '.fIcon'}"
                        text="{text}"
                        tooltip="{text}"
                        iconDensityAware="false"
                        press="onLinkPress"/>
                </HBox>

                <Text class="pf-footer__note" text="{i18n>footer.built}"/>
            </HBox>
        </VBox>
    </VBox>
</core:FragmentDefinition>