<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <VBox class="pf-footer">
        <VBox class="pf-container pf-footer__inner">
            <HBox alignItems="Center" class="pf-row--between pf-row--wrap" width="100%">

                <HBox alignItems="Center" class="pf-gap-3">
                    <Image
                        class="pf-topbar__brand-avatar"
                        src="{content>/profile/avatar}"
                        densityAware="false"
                        alt="{content>/profile/name}"/>
                    <VBox class="sapUiVBoxTiny">
                        <Text class="pf-strong" text="{content>/profile/name}"/>
                        <Text class="pf-text-xs pf-muted" text="{content>/profile/role}"/>
                    </VBox>
                </HBox>

                <HBox alignItems="Center" class="pf-gap-4 pf-row--wrap">
                    <!--
                        Os itens sao adicionados em App.controller (publishUiOptions):
                        sap.m.SegmentedButton usa "buttons" como defaultAggregation,
                        entao um template XML filho nao e atribuido a agregacao "items".
                    -->
                    <SegmentedButton
                        id="themeToggle"
                        selectedKey="{ui>/theme}"
                        selectionChange="onThemeChange"
                        class="pf-footer__toggle"/>

                    <SegmentedButton
                        id="localeToggle"
                        selectedKey="{ui>/locale}"
                        selectionChange="onLocaleChange"
                        class="pf-footer__toggle"/>
                </HBox>

            </HBox>

            <VBox class="pf-separator pf-mt-4 pf-mb-0"/>

            <HBox alignItems="Center" class="pf-row--between pf-row--wrap" width="100%">
                <HBox class="pf-row--wrap" items="{content>/footerLinks}">
                    <Button
                        type="Transparent"
                        icon="{path: 'icon', formatter: '.fIcon'}"
                        text="{text}"
                        tooltip="{text}"
                        iconDensityAware="false"
                        press="onLinkPress"/>
                </HBox>

                <Text class="pf-footer__note" text="{i18n>footer.built}"/>
            </HBox>
        </VBox>
    </VBox>
</core:FragmentDefinition>