<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <VBox class="pf-skill">
        <HBox alignItems="Center" class="pf-gap-3">
            <HBox class="pf-skill__icon" alignItems="Center">
                <Icon src="{path: 'icon', formatter: '.fIcon'}" class="pf-text-lg"/>
            </HBox>
            <Text class="pf-skill__name" text="{name}"/>
            <Text class="pf-skill__level" text="{path: 'level', formatter: '.fLevel'}"/>
        </HBox>

        <HBox class="pf-skill__bar">
            <HBox
                class="pf-skill__bar-fill"
                width="{path: 'level', formatter: '.fLevelPercent'}"/>
        </HBox>

        <Text class="pf-skill__desc" text="{description}" visible="{= !!${description}}"/>

        <HBox class="pf-chips" items="{tags}" visible="{= !!${tags} &amp;&amp; ${tags}.length > 0}">
            <Text class="pf-chip" text="{this>}"/>
        </HBox>
    </VBox>
</core:FragmentDefinition>