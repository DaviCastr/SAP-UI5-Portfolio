<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <VBox class="pf-cert">
        <HBox class="pf-cert__media">
            <Image
                class="pf-cert__image"
                src="{path: 'image', formatter: '.fCertImage'}"
                densityAware="false"
                alt="{title}"
                visible="{= !!${image}}"/>
            <VBox class="pf-cert__fallback" visible="{= !${image}}">
                <Icon src="sap-icon://certification" class="pf-text-xl pf-muted"/>
                <Text class="pf-small" text="{i18n>certificate.imageUnavailable}"/>
            </VBox>
        </HBox>

        <VBox class="pf-cert__body">
            <Text class="pf-cert__issuer" text="{issuer}"/>
            <Text class="pf-cert__title" text="{title}"/>
            <HBox alignItems="Center" class="pf-cert__meta">
                <Icon src="sap-icon://calendar" class="pf-text-xs pf-muted"/>
                <Text class="pf-small pf-muted" text="{path: 'issuedAt', formatter: '.fDate'}"/>
                <Text
                    class="pf-chip pf-chip--warn"
                    text="{i18n>certificate.expired}"
                    visible="{path: 'expiresAt', formatter: '.fExpired'}"/>
            </HBox>
        </VBox>

        <Button
            type="Transparent"
            icon="sap-icon://launch"
            text="{i18n>certificate.view}"
            press="onCertificatePress"
            visible="{= !!${url}}"/>
    </VBox>
</core:FragmentDefinition>