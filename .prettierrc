{
    "printWidth": 110,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "none",
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "overrides": [
        {
            "files": ["*.json"],
            "options": { "tabWidth": 2 }
        },
        {
            "files": ["*.xml", "*.properties"],
            "options": { "tabWidth": 4, "printWidth": 120 }
        }
    ]
}